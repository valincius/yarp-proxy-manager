{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Yarp": "Information"
      }
    }
  },
  "Kestrel": {
    "Endpoints": {
      "ProxyHttp": {
        "Url": "http://0.0.0.0:80"
      },
      "Admin": {
        "Url": "http://0.0.0.0:81"
      }
    }
  },
  "ConnectionStrings": {
    "ProxyDb": null
  },
  "Data": {
    "Directory": null
  },
  "Admin": {
    "Email": null,
    "Password": null
  },
  "AllowedHosts": "*"
}
